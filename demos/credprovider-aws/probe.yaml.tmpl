# The worker pool for the probe actors of both demo atespaces (a pool's
# namespace does not limit which templates select it). deploy.sh replaces the
# ko:// image with the release worker image, pinned by digest, and pins the
# pool to the gvisor node group.
apiVersion: v1
kind: Namespace
metadata:
  name: ate-demo-credprovider
---
apiVersion: ate.dev/v1
kind: WorkerPool
metadata:
  name: credprovider-probe
  namespace: ate-demo-credprovider
  labels:
    workload: credprovider-probe
spec:
  # One actor per atespace at a time; an actor occupies its whole worker.
  replicas: 2
  workerImage: ko://go.ate.dev/substrate/cmd/ateworker-gvisor
  sandboxClasses:
  - name: gvisor
  template:
    resources:
      limits: { cpu: "1", memory: 1Gi }
      requests: { cpu: 250m, memory: 1Gi }
