+
+// assetStoreS3 reports whether a non-Kind install stages microVM assets in S3
+// (ATE_INSTALL_STORAGE_BACKEND=s3) with the aws CLI and its ambient credentials.
+func assetStoreS3() bool { return os.Getenv("ATE_INSTALL_STORAGE_BACKEND") == "s3" }
+
+func (e *Env) stageMicroVMAssetsToS3(ctx context.Context, bucket string, digests map[string]map[string]string) error {
+	for _, arch := range e.microVMArches() {
+		outDir := e.Cfg.Path("bin", microvmAssetsPrefix, arch)
+		for _, f := range microvmAssets {
+			key := fmt.Sprintf("%s/%s/%s", microvmAssetsPrefix, arch, digests[arch][f])
+			if _, err := e.runCmdOutput(ctx, "aws", "s3api", "head-object", "--bucket", bucket, "--key", key); err == nil {
+				log.Infof("   %s/%s already in s3://%s; skipping.", arch, f, bucket)
+				continue
+			}
+			log.Infof("   %s/%s -> s3://%s/%s", arch, f, bucket, key)
+			if err := e.runCmd(ctx, nil, "aws", "s3", "cp", "--only-show-errors", filepath.Join(outDir, f), "s3://"+bucket+"/"+key); err != nil {
+				return fmt.Errorf("while uploading %s/%s to S3: %w", arch, f, err)
+			}
+		}
+	}
+	return nil
+}
