# Worker pool for the counter demo (shape of upstream's
# demos/counter/counter.yaml.tmpl at v1.0.0).

apiVersion: v1
kind: Namespace
metadata:
  name: ate-demo-counter

---

apiVersion: ate.dev/v1
kind: WorkerPool
metadata:
  name: counter
  namespace: ate-demo-counter
  labels:
    workload: counter
spec:
  replicas: 3
  workerImage: ko://go.ate.dev/substrate/cmd/ateworker-gvisor
  # No configRef: the pool follows the class default.
  sandboxClasses:
  - name: gvisor
  template:
    resources:
      limits:
        cpu: "1"
        memory: 1Gi
      requests:
        cpu: 250m
        memory: 1Gi
