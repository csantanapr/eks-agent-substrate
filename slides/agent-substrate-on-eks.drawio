        <mxCell id="footer-1" value="Note: no public load balancers; the Substrate API is reached only via kubectl port-forward. Dashed = TLS over the public internet." style="text;html=1;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;spacingTop=8.523;fontSize=18;fontStyle=0;fontColor=#232F3E;fontFamily=Arial,Helvetica,sans-serif;strokeColor=none;fillColor=none;spacingLeft=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="1640" width="1290" height="40" as="geometry" />
        </mxCell>
        <mxCell id="footer-2" value="Note: ate-api-server -&amp;gt; RDS uses TLS verify-full. ate-api-server and atelet (every gvisor and microvm node, objectstore-plugin sidecar) store snapshots in S3; atelet also reads the microVM asset bucket." style="text;html=1;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;spacingTop=32.523;fontSize=18;fontStyle=0;fontColor=#232F3E;fontFamily=Arial,Helvetica,sans-serif;strokeColor=none;fillColor=none;spacingLeft=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="1640" width="2000" height="70" as="geometry" />
        </mxCell>
        <mxCell id="footer-3" value="Note: also in cluster: k8s-credential-provider, podcertcontroller (mTLS pod certs). Add-ons: vpc-cni (NetworkPolicy), CoreDNS, kube-proxy, Pod Identity Agent, EBS CSI, EFS CSI." style="text;html=1;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;spacingTop=16.523;fontSize=18;fontStyle=0;fontColor=#232F3E;fontFamily=Arial,Helvetica,sans-serif;strokeColor=none;fillColor=none;spacingLeft=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="1680" width="1750" height="50" as="geometry" />
        </mxCell>
        <mxCell id="footer-4" value="Note: EKS Pod Identity gives one IAM role per ServiceAccount; actors get no AWS identity. Rotation Lambdas rotate the ate-owner / ate-readwrite secrets every 30 days." style="text;html=1;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;spacingTop=0.523;fontSize=18;fontStyle=0;fontColor=#232F3E;fontFamily=Arial,Helvetica,sans-serif;strokeColor=none;fillColor=none;spacingLeft=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="1720" width="1650" height="30" as="geometry" />
        </mxCell>
        <mxCell id="footer-5" value="Note: nodes run AL2023 with IMDSv2 (hop limit 1); the microvm launch template enables nested virtualization. EFS and S3 Files access points are per actor volume (optional demo)." style="text;html=1;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;spacingTop=24.523;fontSize=18;fontStyle=0;fontColor=#232F3E;fontFamily=Arial,Helvetica,sans-serif;strokeColor=none;fillColor=none;spacingLeft=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="1720" width="1760" height="60" as="geometry" />
        </mxCell>
        <mxCell id="t-igw" value="Internet gateway" style="text;html=1;whiteSpace=nowrap;overflow=visible;align=left;verticalAlign=top;spacing=0;spacingTop=1.564;fontSize=24;fontStyle=0;fontColor=#232F3E;fontFamily=Arial,Helvetica,sans-serif;strokeColor=none;fillColor=none;spacingLeft=0;" vertex="1" parent="igw">
          <mxGeometry x="90" y="-20" width="220" height="40" as="geometry" />
        </mxCell>
        <mxCell id="t-rds" value="&lt;div style=&quot;line-height:28.80px&quot;&gt;RDS for&lt;/div&gt;&lt;div style=&quot;line-height:27.20px&quot;&gt;PostgreSQL 18&lt;/div&gt;" style="text;html=1;whiteSpace=nowrap;overflow=visible;align=center;verticalAlign=top;spacing=0;spacingTop=-0.436;fontSize=24;fontStyle=0;fontColor=#232F3E;fontFamily=Arial,Helvetica,sans-serif;strokeColor=none;fillColor=none;" vertex="1" parent="rds">
          <mxGeometry x="-60" y="80" width="184" height="70" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
