# Settings for every script. Put your own values (AWS profile, region, tags,
# optional demos) in config.local.env, which is gitignored and read after this.
#
# lib/common.sh reads both files for every script. Neither holds a secret:
# database logins live in Secrets Manager, and AWS access comes from your
# AWS CLI profile.
#
# Learn more:
#   https://docs.aws.amazon.com/cli/latest/userguide/cli-configure-files.html
#   https://docs.aws.amazon.com/AWSEC2/latest/UserGuide/amazon-ec2-nested-virtualization.html
#   https://docs.aws.amazon.com/eks/latest/userguide/cluster-endpoint.html
#   https://docs.aws.amazon.com/bedrock/latest/userguide/inference-profiles.html

# --- Cluster ---
# 2-28 characters of a-z, 0-9 and '-'; S3, IAM, RDS and ECR names derive from it.
CLUSTER_NAME=agent-substrate
AWS_REGION=us-west-2
# Empty: the AWS SDK default chain. Set to a named profile in config.local.env.
AWS_PROFILE=
KUBERNETES_VERSION=1.37
# The microVM (Kata) node group needs an instance type with nested
# virtualization; create-cluster.sh checks it. List them with:
#   aws ec2 describe-instance-types --filters Name=processor-info.supported-features,Values=nested-virtualization
SYSTEM_INSTANCE_TYPE=m8i.xlarge
GVISOR_INSTANCE_TYPE=m8i.2xlarge
MICROVM_INSTANCE_TYPE=m8i.2xlarge
SYSTEM_NODES=2
GVISOR_NODES=2
MICROVM_NODES=2
# Space-separated key=value tags on every AWS resource the scripts create
# (letters, digits and _ . : / + @ -; no spaces). The scripts add an owner
# tag, agent-substrate-on-eks/deployment=<cluster>.<region>, and only reuse
# or delete resources with global names that carry it. auto-delete=no keeps
# account cleanup tools from stopping the cluster's nodes and database.
TAGS="project=agent-substrate auto-delete=no"
# Address ranges allowed to reach the Kubernetes API endpoint (public and
# private access are on). The default is any address, authenticated by IAM;
# set your own, e.g. "203.0.113.0/24".
EKS_PUBLIC_ACCESS_CIDRS="0.0.0.0/0"

# --- Agent Substrate ---
SUBSTRATE_REPO=https://github.com/agent-substrate/substrate.git
# A release tag (v1.0.0, v1.0.1, ...) or "latest" for the newest one.
# SUBSTRATE_TAG in the environment wins: SUBSTRATE_TAG=v1.0.1 ./deploy.sh
SUBSTRATE_TAG=v1.0.0
SUBSTRATE_IMAGE_REPO=ghcr.io/agent-substrate/substrate

# --- Optional mode 3 (preview, a proposal for upstream) ---
# "on": worker Pods are microVMs (Kata Containers on Cloud Hypervisor, on the
# microvm node group) and run actors with gVisor inside, so an escape from
# gVisor still lands in the guest kernel. It replaces the release above with
# the proposal: MODE3_COMMIT of MODE3_REPO, its images under MODE3_IMAGE_REPO
# tagged MODE3_TAG, and the NetworkWorkers preview gate. demos/mode3 installs
# Kata and a counter pool on it.
MODE3=
MODE3_REPO=https://github.com/csantanapr/substrate.git
MODE3_COMMIT=ecdccfede4932a38f69684b3799a316fc3b5beb7
MODE3_TAG=v1.0.0-mode3.ecdccfe
MODE3_IMAGE_REPO=ghcr.io/csantanapr/substrate

# go 1.27 or newer builds ate-setup and kubectl-ate from the vendored source.
# "local" uses the go on PATH; set "auto" to let go download its toolchain.
GOTOOLCHAIN=local

# --- Database (Amazon RDS for PostgreSQL) ---
DB_ENGINE_VERSION=18.3
DB_INSTANCE_CLASS=db.t4g.medium
DB_STORAGE_GB=20
# Production: Multi-AZ, longer backups and deletion protection. clean.sh
# cannot delete a protected instance; turn protection off yourself first.
DB_MULTI_AZ=false
DB_BACKUP_DAYS=1
DB_DELETION_PROTECTION=false

# --- Inference (Amazon Bedrock through the in-cluster LLM gateway) ---
# A cross-region inference profile available in AWS_REGION. A profile names a
# model and the Regions Bedrock may route each request to. Actors get it as
# model "claude". llm-gateway/deploy.sh also serves claude-haiku,
# claude-sonnet and claude-opus: the newest profile of each family with this
# profile's prefix (us.).
BEDROCK_INFERENCE_PROFILE=us.anthropic.claude-haiku-5-5

# --- Optional Amazon EFS volumes for actors (demos/efs) ---
# Each actor gets an EFS access point: an entry into the file system with its
# own root directory and POSIX user.
#   https://docs.aws.amazon.com/efs/latest/ug/efs-access-points.html
# The aws-efs-csi-driver EKS add-on version (aws eks describe-addon-versions).
EFS_ADDON_VERSION=v3.5.3-eksbuild.1
# The user and group each actor's access point writes as. Match the user the
# actor runs as: actors have no CAP_DAC_OVERRIDE, so even root cannot write a
# 0700 directory another uid owns. The counter demo runs as root.
EFS_UID=0
EFS_GID=0

# --- Optional OpenClaw always-on agent demo ---
# A checkout of the always-on-agent repository with the demo/eks scripts:
# either a local path, or a git URL and ref to clone into .work/. Empty: skipped.
OPENCLAW_DIR=
OPENCLAW_REPO=
OPENCLAW_REF=
# E.164 number allowed to message the agent on WhatsApp. Empty: no WhatsApp.
WHATSAPP_PEER=
