# Settings for every install. Put your own values (AWS profile, Region,
# tags, plugin settings) in config.local.env, which is gitignored and read
# after this file. The environment wins over both.
#
# The installer reads both files: the wizard's Settings screen shows the
# comment above each key as its help, and writes your answers to
# config.local.env when an install starts. Neither file holds a secret:
# database logins live in Secrets Manager, and AWS access comes from your
# AWS CLI profile.
#
# Learn more:
#   https://docs.aws.amazon.com/cli/latest/userguide/cli-configure-files.html
#   https://docs.aws.amazon.com/AWSEC2/latest/UserGuide/amazon-ec2-nested-virtualization.html
#   https://docs.aws.amazon.com/eks/latest/userguide/cluster-endpoint.html
#   https://docs.aws.amazon.com/bedrock/latest/userguide/inference-profiles.html

# --- Cluster ---
# 2-21 characters of a-z, 0-9 and '-'; S3, IAM, RDS and ECR names derive from it.
CLUSTER_NAME=agent-substrate
AWS_REGION=us-west-2
# Empty: the AWS SDK default chain. Set to a named profile in config.local.env.
AWS_PROFILE=
KUBERNETES_VERSION=1.37
# The microVM (Kata) node group needs an instance type with nested
# virtualization; setup-aws create cluster checks it. List them with:
#   aws ec2 describe-instance-types --filters Name=processor-info.supported-features,Values=nested-virtualization
SYSTEM_INSTANCE_TYPE=m8i.xlarge
GVISOR_INSTANCE_TYPE=m8i.2xlarge
MICROVM_INSTANCE_TYPE=m8i.2xlarge
SYSTEM_NODES=2
GVISOR_NODES=2
MICROVM_NODES=2
# The AMI of the node groups. Empty: the Amazon EKS optimized Amazon Linux
# 2023 AMI, which EKS picks for the cluster's version. An AMI you bring must
# join the cluster with nodeadm, as the EKS optimized AL2023 AMI and AMIs
# built from it or with awslabs/amazon-eks-ami do; the launch template gives
# it a NodeConfig with the cluster's details and the group's labels and
# taints. Its architecture must match the instance types. Teardown never
# deletes it. Fixed for a node group once the group exists.
#   https://docs.aws.amazon.com/eks/latest/userguide/launch-templates.html#launch-template-custom-ami
NODE_AMI_ID=
# The type of the node groups. "managed": EKS managed node groups.
# "self-managed": an Auto Scaling group <cluster>-<group> per node group,
# which you own, with an instance profile and an EC2_LINUX access entry for
# the node role. Its nodes join with the NodeConfig in their launch template,
# on NODE_AMI_ID or the recommended EKS optimized AL2023 AMI. A cluster has
# one type: create cluster stops on node groups of the other type.
#   https://docs.aws.amazon.com/eks/latest/userguide/launch-workers.html
NODE_GROUP_TYPE=managed
# Where the nitro sandbox class (the AWS Nitro sandbox) runs. "auto-mode":
# each worker Pod an EKS Auto Mode isolated sandbox, on nodes Auto Mode
# launches; it needs AUTO_MODE=on and makes no node group. "node-group": on
# the nitro node group, of NODE_GROUP_TYPE, which a new cluster gets with
# the class: NITRO_NODES of NITRO_INSTANCE_TYPE with Nitro Enclaves on, from
# the Nitro Sandbox AMI NITRO_AMI_ID, labeled ate.dev/pool=nitro and
# tainted ate.dev/sandboxClass=nitro. It needs no Auto Mode. On a cluster
# you connect, it needs nodes labeled ate.dev/pool=nitro.
#   https://docs.aws.amazon.com/eks/latest/userguide/sandboxing-ami-create-update.html
NITRO_COMPUTE=auto-mode
# The nitro node group's AMI, required with NITRO_COMPUTE=node-group: a
# Nitro Sandbox AMI, which the EKS optimized AMI is not. Build one for the
# cluster's Kubernetes version with awslabs/amazon-eks-ami, for 1.37:
#   make k8s=1.37 os_distro=al2023 enable_pod_isolation=true
# Its nodes must advertise eks.amazonaws.com/nitro-sandbox: create cluster
# waits for it and stops when they do not. Teardown never deletes the AMI.
NITRO_AMI_ID=
# The nitro node group's instance type needs Nitro Enclaves; create cluster
# checks it. List the types that have them with:
#   aws ec2 describe-instance-types --filters Name=nitro-enclaves-support,Values=supported
NITRO_INSTANCE_TYPE=m8i.xlarge
NITRO_NODES=1
# EKS Auto Mode. "on": the cluster also gets Auto Mode and its two built-in
# NodePools, general-purpose and system, next to the node groups above.
# The system group is then tainted ate.dev/workloadType=ate-system-infra, so
# like the gvisor and microvm groups it takes only the pods meant for it: the
# Substrate control plane with RDS and the plugins' controllers, which
# tolerate the taint. Any other pod, with no nodeSelector or toleration, runs on a node
# Auto Mode launches for it. Empty: no Auto Mode, no taint. Fixed when the
# cluster is created.
#   https://docs.aws.amazon.com/eks/latest/userguide/automode.html
AUTO_MODE=on
# Space-separated key=value tags on every AWS resource the installer creates
# (letters, digits and _ . : / + @ -; no spaces). The installer adds an owner
# tag, agent-substrate-on-eks/deployment=<cluster>.<region>, and only reuses
# or deletes resources with global names that carry it. auto-delete=no keeps
# account cleanup tools from stopping the cluster's nodes and database.
TAGS="project=agent-substrate auto-delete=no"
# Address ranges allowed to reach the Kubernetes API endpoint (public and
# private access are on; IAM authenticates every call). "auto" allows only
# this machine's public address, as a /32. When the network reaches the
# internet from several addresses, auto is refused: set your egress ranges
# instead, e.g. "203.0.113.0/24", or "0.0.0.0/0" for any address.
EKS_PUBLIC_ACCESS_CIDRS=auto

# --- Agent Substrate ---
# Sandbox classes, comma-separated, in any combination: gvisor (actors in
# gVisor on the gvisor node group), microvm (actors in Kata microVMs on the
# microvm node group, nested virtualization) and nitro (the AWS Nitro
# sandbox, which installs the fork's release: each worker Pod an EKS Auto
# Mode isolated sandbox, on nodes Auto Mode launches, which needs
# AUTO_MODE=on and makes no node group; or with NITRO_COMPUTE=node-group a
# sandbox on the nitro node group). A new cluster gets the gvisor and
# microvm groups of its classes, the nitro group with NITRO_COMPUTE=node-group,
# and the microvm group for the mode3 plugin, plus the system group without
# Auto Mode, with RDS and a sandbox group (the control plane is pinned
# there), or for a plugin that runs on it. So AUTO_MODE=on with the bundled
# PostgreSQL and SANDBOX_CLASSES=gvisor makes the gvisor group alone. With
# SANDBOX_CLASSES=nitro on Auto Mode's nodes it makes a node group only for
# a plugin that adds one (mode3's microvm, or system for a plugin that runs
# on it), and none without such a plugin.
SANDBOX_CLASSES=gvisor,microvm
# A release tag (v1.0.0, v1.0.1, ...). SUBSTRATE_TAG in the environment wins.
SUBSTRATE_TAG=v1.0.0
# Where the release's images come from.
SUBSTRATE_IMAGE_REPO=ghcr.io/agent-substrate/substrate

# --- Database (Amazon RDS for PostgreSQL, setup-aws create rds) ---
DB_ENGINE_VERSION=18.3
DB_INSTANCE_CLASS=db.t4g.medium
DB_STORAGE_GB=20
# Production: Multi-AZ, longer backups and deletion protection. Teardown
# cannot delete a protected instance; turn protection off yourself first.
DB_MULTI_AZ=false
DB_BACKUP_DAYS=1
DB_DELETION_PROTECTION=false

# --- Inference (the llm-gateway plugin: Amazon Bedrock through the in-cluster LLM gateway) ---
# A cross-region inference profile available in AWS_REGION. A profile names a
# model and the Regions Bedrock may route each request to. Actors get it as
# model "claude". The gateway also serves claude-haiku, claude-sonnet and
# claude-opus: the newest profile of each family with this profile's prefix
# (us.).
BEDROCK_INFERENCE_PROFILE=us.anthropic.claude-haiku-5-5

# --- Amazon EFS volumes for actors (the efs plugin) ---
# Each actor gets an EFS access point: an entry into the file system with its
# own root directory and POSIX user.
#   https://docs.aws.amazon.com/efs/latest/ug/efs-access-points.html
# The aws-efs-csi-driver EKS add-on version (aws eks describe-addon-versions).
EFS_ADDON_VERSION=v3.5.3-eksbuild.1

# --- OpenClaw always-on agent (the openclaw plugin) ---
# Its images. Empty: the public ones the installer pins, built from
# csantanapr/always-on-agent for linux/amd64. Another image must be pinned by
# digest, <image>@sha256:<digest>, since actor snapshots require a pinned
# image; the plugin refuses one that is not.
OPENCLAW_GATEWAY_IMAGE=
OPENCLAW_ACTOR_IMAGE=
OPENCLAW_DASHBOARD_IMAGE=
# Worker Pods for the agent actors. Empty: 3.
OPENCLAW_WORKERS=
# E.164 number allowed to message the agent on WhatsApp. Empty: no WhatsApp.
WHATSAPP_PEER=
